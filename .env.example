# ==============================================================================
# SEO Audit Agent - AI Provider Configuration
# ==============================================================================
# You only need to set ONE of the keys below to enable AI enhancements.
# If no keys are provided, the system automatically runs in 100% deterministic manual mode.
# To activate: copy this file to `.env` and paste your key.
# ==============================================================================

# 1. Google Gemini (Free Tier: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 2. Groq Cloud (Free Tier Llama-3.3-70B: https://console.groq.com/keys)
GROQ_API_KEY=

# 3. OpenAI (Paid / Trial: https://platform.openai.com/api-keys)
OPENAI_API_KEY=
